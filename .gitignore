# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build output
build/bin/

# Windows resource file, regenerated per build from build/windows/{icon.ico,
# info.json,wails.exe.manifest} via `wails3 generate syso` (see
# .context/specs/2026-08-09-wails-v3-build-packaging-design.md). go build
# auto-links any wails_windows_<arch>.syso next to main_windows.go.
wails_windows_*.syso

# Linux AppImage icon, regenerated per build as a copy of build/appicon.png
# (the .desktop file's Icon= key requires a matching basename).
build/linux/tokentally.png

# Go
vendor/
*.test
*.out
coverage.html
go.work
go.work.sum
*.log

# Database & runtime data
*.db
*.db-shm
*.db-wal

# Wails generated bindings (regenerated by `wails dev` / `wails build`)
frontend/web/wailsjs/

# Wails v3 generated bindings (regenerate with:
# wails3 generate bindings -d frontend/inspector/src/bindings -ts -i ./...)
frontend/inspector/src/bindings/

# Vue full-app build output (generated by `npm run build` in frontend/inspector)
frontend/web/app.bundle.js
frontend/web/app.css
frontend/web/inspector/

# Node modules for the inspector micro-app
frontend/inspector/node_modules/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Env / secrets
.env
*.env.local

# Git worktrees
.worktrees/

# Claude Code tooling
# .claude/ is committed (skills, slash commands, settings.json define the
# agent contract for this repo). Only the per-contributor and per-session
# files are ignored.
.claude/settings.local.json
.claude/.current-tool
.superpowers/
.impeccable.md
HANDOFF.md
skills-lock.json
docs/


